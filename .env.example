# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin User ID (your Telegram numeric ID from @userinfobot)
ADMIN_USER_ID=123456789

# Secret key for encrypting user Binance API credentials (32 url-safe base64-encoded bytes)
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your_generated_fernet_key_here

# Tree News WebSocket (Default free public endpoint)
TREE_NEWS_WS_URL=wss://news.treeofalpha.com/ws

# Tree News Optional API Key (leave empty if using free public ws)
TREE_NEWS_API_KEY=

# Binance API Base URLs
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# Database path
DATABASE_PATH=data/bot.db

# Telegram Mini App (Web server)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# Set your public HTTPS URL (e.g. via Cloudflare Tunnel, ngrok, or your domain)
WEBAPP_URL=https://your-domain.com


