# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Admin User ID (your Telegram numeric ID from @userinfobot)
ADMIN_USER_ID=123456789

# Bot username without the @, used to build Mini App links. Leave unset to use TheCapoSniperBot.
# TELEGRAM_BOT_USERNAME=your_bot_username

# Secret key for encrypting user Binance API credentials (32 url-safe base64-encoded bytes)
# Run: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_MASTER_KEY=your_generated_fernet_key_here

# 12-word seed phrase every user's Solana and EVM deposit wallet is derived from.
# Set your own and keep it private: anyone holding it controls those wallets.
# Run: python -c "from bip_utils import Bip39MnemonicGenerator; print(Bip39MnemonicGenerator().FromWordsNumber(12))"
MASTER_WALLET_MNEMONIC=

# Tree News WebSocket (Default free public endpoint)
TREE_NEWS_WS_URL=wss://news.treeofalpha.com/ws

# Tree News Optional API Key (leave empty if using free public ws)
TREE_NEWS_API_KEY=

# Binance API Base URLs
BINANCE_SPOT_BASE_URL=https://api.binance.com
BINANCE_FUTURES_BASE_URL=https://fapi.binance.com

# HTTP proxy for Binance requests, needed when the host's region is blocked by Binance
# Format: http://user:password@host:port
BINANCE_PROXY_URL=

# Database path
DATABASE_PATH=data/bot.db

# Telegram Mini App (Web server)
WEBAPP_HOST=0.0.0.0
WEBAPP_PORT=8080
# On Railway, PORT and RAILWAY_PUBLIC_DOMAIN are injected and override WEBAPP_PORT / fill in WEBAPP_URL
# Set your public HTTPS URL (e.g. via Cloudflare Tunnel, ngrok, or your domain)
WEBAPP_URL=https://your-domain.com
